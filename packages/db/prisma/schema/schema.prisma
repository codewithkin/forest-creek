generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id            String    @id @default(cuid())
  tier          String    @unique
  name          String
  description   String
  pricePerNight Int
  capacity      Int
  bedType       String
  amenities     String[]
  image         String
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]

  @@map("room")
}

model Activity {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  price       Int
  currency    String   @default("USD")
  image       String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("activity")
}

model Booking {
  id            String    @id @default(cuid())
  reference     String    @unique
  guestName     String
  guestEmail    String
  guestPhone    String?
  roomId        String?
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomName      String
  roomRate      Int
  checkIn       DateTime
  checkOut      DateTime
  nights        Int
  guests        Int
  activityIds   String[]
  activityNames String[]
  subtotal      Int
  totalAmount   Int
  paymentMethod String
  paymentStatus String    @default("pending")
  bookingStatus String    @default("pending")
  notes         String?
  verifiedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([guestEmail])
  @@map("booking")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  sender    String
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_message")
}