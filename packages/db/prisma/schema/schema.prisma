generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  location    String
  phone       String
  email       String
  heroImage   String
  gallery     String[]
  amenities   String[]
  // Shown to a guest when payment is requested — bank details, mobile money,
  // or whatever this property actually accepts.
  paymentInstructions String?
  paymentLink         String?
  // Denormalised onto Booking at write time, so a later rate change never
  // rewrites what a guest agreed to.
  currency    String   @default("USD")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms      Room[]
  activities Activity[]
  bookings   Booking[]
  staff      StaffProperty[]
  chats      ChatMessage[]
  dayVisits        DayVisit[]
  dayVisitBookings DayVisitBooking[]
  quotes           Quote[]
  invoices         Invoice[]
  fileFolders      FileFolder[]
  storedFiles      StoredFile[]

  @@map("property")
}

model StaffProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("staff_property")
}

model Room {
  id            String    @id @default(cuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tier          String
  name          String
  description   String
  pricePerNight Int
  capacity      Int
  bedType       String
  amenities     String[]
  // Cover photo, always images[0] when images is non-empty. Kept as its own
  // column because bookings, the AI tools and older clients read it directly.
  image         String
  // Full ordered gallery, cover first.
  images        String[]  @default([])
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  blocks        RoomBlock[]
  ratePeriods   RoomRatePeriod[]

  @@unique([propertyId, tier])
  @@index([propertyId])
  @@map("room")
}

model Activity {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  // 0 means the experience is included in the stay. There is deliberately no
  // separate "free" flag: two fields could disagree, one cannot.
  price       Int
  currency    String   @default("USD")
  // Cover photo, always images[0] when images is non-empty — same pair as Room.
  image       String
  images      String[] @default([])
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, slug])
  @@index([propertyId])
  @@map("activity")
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  propertyName  String
  guestName     String
  guestEmail    String
  guestPhone    String?
  // The chat the assistant took this booking in ("whatsapp:…" or the website
  // widget's session). On the website a guest has no phone to be known by, so
  // this is how the assistant recognises their own bookings.
  chatSessionId String?
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomName      String
  roomRate      Int
  // The price of each night, in order — differs from roomRate (then their
  // average) when the stay crosses a RoomRatePeriod. Empty on bookings made
  // before prices by date; those charged roomRate every night.
  nightlyRates  Int[]    @default([])
  checkIn       DateTime
  checkOut      DateTime
  nights        Int
  guests        Int
  activityIds   String[]
  activityNames String[]
  subtotal      Int
  totalAmount   Int
  paymentMethod String
  paymentStatus String   @default("pending")
  bookingStatus String   @default("pending")
  notes         String?
  verifiedBy    String?
  // Where the booking came from, so managers can see what WhatsApp is worth.
  channel            String    @default("web")
  paymentRequestedAt DateTime?
  // An unpaid booking keeps its room only until this moment (see
  // packages/db/src/hold-policy.ts). Null for bookings made before holds.
  holdExpiresAt DateTime?
  // Set when a booking needs a human: e.g. Paynow reported it paid after its
  // hold had lapsed and the room had been re-booked. Cleared when resolved.
  reviewNote String?
  // Paynow mobile money (see packages/payments). The number charged is asked
  // for explicitly and may differ from guestPhone — a WhatsApp number is not
  // necessarily on the network the guest's mobile money account uses.
  mobileMoneyNumber String?
  paynowPollUrl     String?
  // Paynow's own transaction reference and last known status string (e.g.
  // "created", "paid", "cancelled"), kept for support and debugging.
  paynowReference String?
  paynowStatus    String?
  // Paynow has no refund API, so a refund is a staff decision recorded here:
  // null (nothing owed), "due" (a paid booking was cancelled), then
  // "refunded" (with the transfer's reference in refundNote) or "declined"
  // (kept under the cancellation policy, with the reason in refundNote).
  // The Booking & Cancellation Policy (packages/db/src/booking-policy.ts).
  // What has actually been received, in USD, across every charge and any
  // payment staff recorded by hand (bank transfer, cash).
  amountPaid    Int       @default(0)
  // What secures the booking (50%, or the whole stay when booked within 14
  // days of arrival). Null on bookings from before the policy: those paid in full.
  depositAmount Int?
  // When the balance is due (14 days before arrival); null when nothing is left.
  balanceDueAt  DateTime?
  // The amount of the Paynow charge in flight; cleared once it is credited, so
  // a charge can never be counted twice.
  paynowChargeAmount Int?
  // Date changes made so far — only the first can be free (clause 4).
  dateChanges   Int       @default(0)
  // When the guest agreed to the policy (the checkbox, or confirming in WhatsApp).
  policyAcceptedAt DateTime?
  // Staff who entered the booking by hand, and how it reached them (walk-in,
  // phone, email, agent, other). Null on website and WhatsApp bookings.
  createdBy String?
  source    String?
  // Why a booking is not at the calendar's price: an agreed rate, a discount.
  rateNote  String?
  // The quotation this stay was accepted from.
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // The stay itself, set from the dashboard (or the sweeper, for a check-out
  // nobody pressed).
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  // What the policy says goes back on cancellation, after the 5% fee, in cents.
  refundAmountCents Int?
  refundStatus String?
  refundNote   String?
  refundedBy   String?
  refundedAt   DateTime?
  notifications Notification[]
  paymentEvents PaymentEvent[]
  receipts      Receipt[]
  events        BookingEvent[]
  files         StoredFile[]
  invoices      Invoice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([guestEmail])
  @@index([propertyId, checkIn])
  @@index([propertyId, bookingStatus])
  @@index([channel])
  @@index([bookingStatus, holdExpiresAt])
  @@index([refundStatus])
  @@index([quoteId])
  @@map("booking")
}

// What happened to a booking and who did it: staff by email, or "system" for
// everything automatic. Append-only; written by logBookingEvent, which never
// throws, so the record of a change can never make the change fail.
model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // created | payment | status | dates | room | details | experiences |
  // check-in | check-out | cancelled | refund
  kind      String
  actor     String
  detail    String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_event")
}

model ChatMessage {
  id         String    @id @default(cuid())
  sessionId  String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sender     String
  content    String
  // Photos sent with an assistant reply (URLs as stored), shown under it.
  images     String[]  @default([])
  // Staff mark a thread handled so the inbox can show what still needs a reply.
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([propertyId])
  @@map("chat_message")
}

// An email about a booking, written in the same step as the change it reports
// and delivered later by the API server (apps/server/src/notification-worker.ts).
// A mail outage therefore delays a message but never loses or blocks a booking,
// and every message has a visible outcome staff can check and retry.
model Notification {
  id            String    @id @default(cuid())
  // At most one of these: a stay, a day visit or a quotation.
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dayVisitBookingId String?
  dayVisitBooking   DayVisitBooking? @relation(fields: [dayVisitBookingId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // For messages about nothing above (scheduled reports): one per key, ever.
  dedupeKey     String?   @unique
  // created | confirmed | cancelled | expired | review — see notifications.ts
  event         String
  // guest | staff
  audience      String
  recipient     String
  subject       String
  // The plain-text part. `content` is the EmailDocument both parts are
  // rendered from (packages/mail/src/layout.ts); null on rows queued before
  // emails had one, which are sent as plain text in the same layout.
  body          String
  content       Json?
  // pending | sent | failed | skipped
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // One message per event per recipient, so the poller, the Paynow callback
  // and a sweep reporting the same payment can all queue it and one is sent.
  @@unique([bookingId, event, recipient])
  @@unique([dayVisitBookingId, event, recipient])
  @@unique([quoteId, event, recipient])
  @@index([status, nextAttemptAt])
  @@map("notification")
}

// A day out with no night's stay — the garden, the grounds, lunch — that
// staff set up per property. Guests ask for a date; staff confirm it.
model DayVisit {
  id             String   @id @default(cuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String
  // Per person, whole dollars. Null is "price to be announced": the lodge has
  // not set one yet, and guests can still ask to come.
  pricePerPerson Int?
  currency       String   @default("USD")
  // Optional: without photos the property's own cover stands in.
  image          String   @default("")
  images         String[] @default([])
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookings       DayVisitBooking[]

  @@unique([propertyId, slug])
  @@index([propertyId])
  @@map("day_visit")
}

// A guest's request to come for a day visit. Nothing is paid online: staff
// confirm the date (quoting a price if none was published) or decline it.
model DayVisitBooking {
  id             String    @id @default(cuid())
  // FD-XXXXXX, apart from a stay's FC- references.
  reference      String    @unique
  dayVisitId     String
  dayVisit       DayVisit  @relation(fields: [dayVisitId], references: [id], onDelete: Restrict)
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Snapshot, so renaming the visit later never rewrites what a guest asked for.
  visitName      String
  // UTC midnight, like a stay's dates.
  visitDate      DateTime
  guests         Int
  guestName      String
  guestEmail     String
  guestPhone     String
  note           String?
  // The published price when the guest asked, or what staff quoted on
  // confirming. Null while still to be announced.
  pricePerPerson Int?
  // requested | confirmed | declined | cancelled
  status         String    @default("requested")
  staffNote      String?
  handledBy      String?
  handledAt      DateTime?
  channel        String    @default("web")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notifications  Notification[]

  @@index([propertyId, visitDate])
  @@index([status])
  @@map("day_visit_booking")
}

// A priced offer for a stay or an event, sent to a guest. The id (a cuid) is the
// guest's link: unguessable, unlike the number. Prices are frozen on the lines
// when it is written, so a later price change never alters what was offered.
// A quotation holds no room: accepting one makes bookings, and paying secures them.
model Quote {
  id            String    @id @default(cuid())
  // Sequential and never reused; shown as FCQ-<year>-<6 digits>.
  number        Int       @unique @default(autoincrement())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // draft | sent | viewed | accepted | declined | expired | cancelled
  status        String    @default("draft")
  guestName     String
  guestEmail    String    @default("")
  guestPhone    String?
  company       String?
  // UTC midnight of the last day it can be accepted.
  validUntil    DateTime
  // Shown to the guest.
  notes         String?
  subtotal      Int
  discount      Int       @default(0)
  discountNote  String?
  total         Int
  sendCount     Int       @default(0)
  sentAt        DateTime?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  declineReason String?
  reminderSentAt DateTime?
  // What went wrong the last time, for staff: a send that failed, or an
  // acceptance refused because a room had gone. Cleared when it next succeeds.
  problem       String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lines         QuoteLine[]
  bookings      Booking[]
  notifications Notification[]
  files         StoredFile[]

  @@index([propertyId, status])
  @@index([status, validUntil])
  @@map("quote")
}

model QuoteLine {
  id          String    @id @default(cuid())
  quoteId     String
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // room | experience | custom
  kind        String
  roomId      String?
  description String
  // Stay lines only, UTC midnights like a booking.
  checkIn     DateTime?
  checkOut    DateTime?
  guests      Int?
  // Whole USD: per night on a room line, each otherwise.
  unitPrice   Int
  // Nights on a room line.
  quantity    Int
  amount      Int
  sortOrder   Int       @default(0)

  @@index([quoteId])
  @@map("quote_line")
}

// The document store. propertyId null is group-wide, for the owner alone; a
// property's files stay as group-wide ones if the property is ever removed.
model FileFolder {
  id         String       @id @default(cuid())
  name       String
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   FileFolder[] @relation("FolderTree")
  files      StoredFile[]
  createdBy  String
  createdAt  DateTime     @default(now())

  @@index([propertyId])
  @@index([parentId])
  @@map("file_folder")
}

model StoredFile {
  id          String      @id @default(cuid())
  // The object in R2. Secret: 256 random bits are what protect the file.
  key         String      @unique
  name        String
  contentType String
  sizeBytes   Int
  description String?
  folderId    String?
  folder      FileFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  // pending until the upload is confirmed | ready
  status      String      @default("pending")
  // In the trash since then; purged from R2 after 30 days.
  deletedAt   DateTime?
  uploadedBy  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  shares      FileShare[]

  @@index([propertyId, deletedAt])
  @@index([folderId])
  @@index([bookingId])
  @@index([quoteId])
  @@index([status, createdAt])
  @@map("stored_file")
}

// A link to one file for someone without a login.
model FileShare {
  id           String     @id @default(cuid())
  token        String     @unique
  fileId       String
  file         StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  passwordHash String?
  maxDownloads Int?
  downloads    Int        @default(0)
  revokedAt    DateTime?
  createdBy    String
  createdAt    DateTime   @default(now())

  @@index([fileId])
  @@map("file_share")
}

// Who wants a report by email, and how often. Absent is the default: nobody
// is mailed until they ask.
model ReportSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // day | week | month
  period    String
  createdAt DateTime @default(now())

  @@unique([userId, period])
  @@map("report_subscription")
}

// Nights staff have taken off sale: maintenance, the owners' own use, a
// closed season. Read by every availability check alongside bookings (see
// packages/db/src/room-blocks.ts), so a blocked night is unbookable on the
// site, in WhatsApp and in the calendar at once.
model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // UTC midnights, like Booking.checkIn/checkOut: startDate is the first
  // blocked night, endDate the morning it opens again (exclusive).
  startDate DateTime
  endDate   DateTime
  reason    String
  // Staff email, for the record of who took the room off sale.
  createdBy String
  createdAt DateTime @default(now())

  @@index([roomId, startDate])
  @@map("room_block")
}

// What Paynow told us, and what we did with it: every result callback
// (including forged or mismatched ones), plus polls that confirmed a payment
// or failed to reach Paynow. The audit trail for "the guest says they paid",
// and what the dashboard's attention panel counts to spot a Paynow outage.
model PaymentEvent {
  id              String   @id @default(cuid())
  // Null when the event could not be tied to a booking (e.g. a forged callback).
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // callback | poll
  source          String
  // The reference as CLAIMED by the event — unverified when outcome is rejected.
  reference       String?
  // Paynow's status string, e.g. "paid", "cancelled"
  status          String?
  // confirmed | already-paid | status-recorded | amount-mismatch |
  // poll-url-mismatch | unknown-booking | no-payment-started | rejected | error
  outcome         String
  detail          String?
  amount          String?
  paynowReference String?
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([outcome, createdAt])
  @@map("payment_event")
}

// One receipt per payment received — a Paynow charge credited, or a bank
// transfer / cash payment staff recorded. Issued in the same step that
// credits the money, so a receipt always matches amountPaid. The id (a cuid)
// is the download key: unguessable, unlike the booking reference.
model Receipt {
  id              String   @id @default(cuid())
  // Sequential and never reused; shown as FCR-<year>-<6 digits>.
  number          Int      @unique @default(autoincrement())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Whole USD received by this payment.
  amount          Int
  // deposit | balance | full | part
  kind            String
  // ecocash | onemoney | innbucks | visa | bank_transfer | cash
  method          String
  // paynow | manual
  source          String
  paynowReference String?
  // Staff note for a manual payment (bank reference, receipt book no.).
  note            String?
  // The booking's totals right after this payment, frozen for the receipt.
  paidToDate      Int
  balanceAfter    Int
  issuedAt        DateTime @default(now())

  @@index([bookingId, issuedAt])
  @@map("receipt")
}

// The WhatsApp agent's linked-device session: whatsapp-web.js's RemoteAuth
// zips the Chromium profile that holds the pairing and hands it to the agent,
// which keeps it here (apps/agent/src/session-store.ts). On disk it was lost
// on every redeploy and the lodge phone had to be scanned again. Opaque bytes,
// written every few minutes; deleted when the device is logged out or the
// phone unlinks it.
model WhatsappSession {
  session   String   @id
  data      Bytes
  sizeBytes Int
  updatedAt DateTime @default(now()) @updatedAt

  @@map("whatsapp_session")
}

/// A booking read back to a WhatsApp guest and waiting for their "yes"
/// (packages/ai ConfirmationGate). In the database, not in memory, so a
/// redeploy between the read-back and the confirmation does not lose it.
/// One row per guest and exact set of details.
model PendingConfirmation {
  id        String   @id @default(cuid())
  guest     String
  key       String
  turnId    String
  details   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([guest, key])
  @@index([guest])
  @@map("pending_confirmation")
}

/// A price for a room on chosen dates — a season, a holiday, an event — set by
/// staff in the dashboard. Nights inside it cost pricePerNight; every other
/// night costs the room's own pricePerNight. Periods for one room never
/// overlap (checked in packages/db/src/rate-periods.ts).
model RoomRatePeriod {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name          String
  // UTC midnights, like stays: startDate is the first night at this price,
  // endDate the first night back at the normal price (exclusive).
  startDate     DateTime
  endDate       DateTime
  pricePerNight Int
  // Staff email, for the record of who set it.
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([roomId, startDate])
  @@map("room_rate_period")
}

// A tax invoice, the lodge's paper invoice book made digital. Money is in
// CENTS here (VAT makes cents), unlike bookings' whole dollars.
model Invoice {
  id          String    @id @default(cuid())
  // Sequential and never reused; shown as INV-<year>-<4 digits>.
  number      Int       @unique @default(autoincrement())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // The stay it was made from, if any. The invoice keeps its own copy of everything.
  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // issued | paid | void. Invoices are voided, never deleted.
  status      String    @default("issued")
  billedTo    String
  company     String?
  email       String    @default("")
  phone       String?
  // The paper book's "REF No.": an order number, a booking reference.
  reference   String?
  // UTC midnight.
  issuedOn    DateTime
  dueOn       DateTime?
  // Percent, 0 when VAT isn't charged.
  vatRate     Float     @default(0)
  subtotalCents Int
  vatCents    Int
  totalCents  Int
  // Received against it, shown as "paid" and "balance due".
  paidCents   Int       @default(0)
  notes       String?
  preparedBy  String
  sendCount   Int       @default(0)
  sentAt      DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lines       InvoiceLine[]

  @@index([propertyId, issuedOn])
  @@index([bookingId])
  @@map("invoice")
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  // Shown under the description: "3 Dec 2026 to 6 Dec 2026".
  detail         String?
  quantity       Float
  unitPriceCents Int
  amountCents    Int
  sortOrder      Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_line")
}
