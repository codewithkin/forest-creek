generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  location    String
  phone       String
  email       String
  heroImage   String
  gallery     String[]
  amenities   String[]
  // Shown to a guest when payment is requested — bank details, mobile money,
  // or whatever this property actually accepts.
  paymentInstructions String?
  paymentLink         String?
  // Denormalised onto Booking at write time, so a later rate change never
  // rewrites what a guest agreed to.
  currency    String   @default("USD")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms      Room[]
  activities Activity[]
  bookings   Booking[]
  staff      StaffProperty[]
  chats      ChatMessage[]
  dayVisits        DayVisit[]
  dayVisitBookings DayVisitBooking[]

  @@map("property")
}

model StaffProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("staff_property")
}

model Room {
  id            String    @id @default(cuid())
  propertyId    String
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tier          String
  name          String
  description   String
  pricePerNight Int
  capacity      Int
  bedType       String
  amenities     String[]
  // Cover photo, always images[0] when images is non-empty. Kept as its own
  // column because bookings, the AI tools and older clients read it directly.
  image         String
  // Full ordered gallery, cover first.
  images        String[]  @default([])
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  blocks        RoomBlock[]

  @@unique([propertyId, tier])
  @@index([propertyId])
  @@map("room")
}

model Activity {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String
  // 0 means the experience is included in the stay. There is deliberately no
  // separate "free" flag: two fields could disagree, one cannot.
  price       Int
  currency    String   @default("USD")
  // Cover photo, always images[0] when images is non-empty — same pair as Room.
  image       String
  images      String[] @default([])
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([propertyId, slug])
  @@index([propertyId])
  @@map("activity")
}

model Booking {
  id            String   @id @default(cuid())
  reference     String   @unique
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  propertyName  String
  guestName     String
  guestEmail    String
  guestPhone    String?
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomName      String
  roomRate      Int
  checkIn       DateTime
  checkOut      DateTime
  nights        Int
  guests        Int
  activityIds   String[]
  activityNames String[]
  subtotal      Int
  totalAmount   Int
  paymentMethod String
  paymentStatus String   @default("pending")
  bookingStatus String   @default("pending")
  notes         String?
  verifiedBy    String?
  // Where the booking came from, so managers can see what WhatsApp is worth.
  channel            String    @default("web")
  paymentRequestedAt DateTime?
  // An unpaid booking keeps its room only until this moment (see
  // packages/db/src/hold-policy.ts). Null for bookings made before holds.
  holdExpiresAt DateTime?
  // Set when a booking needs a human: e.g. Paynow reported it paid after its
  // hold had lapsed and the room had been re-booked. Cleared when resolved.
  reviewNote String?
  // Paynow mobile money (see packages/payments). The number charged is asked
  // for explicitly and may differ from guestPhone — a WhatsApp number is not
  // necessarily on the network the guest's mobile money account uses.
  mobileMoneyNumber String?
  paynowPollUrl     String?
  // Paynow's own transaction reference and last known status string (e.g.
  // "created", "paid", "cancelled"), kept for support and debugging.
  paynowReference String?
  paynowStatus    String?
  // Paynow has no refund API, so a refund is a staff decision recorded here:
  // null (nothing owed), "due" (a paid booking was cancelled), then
  // "refunded" (with the transfer's reference in refundNote) or "declined"
  // (kept under the cancellation policy, with the reason in refundNote).
  // The Booking & Cancellation Policy (packages/db/src/booking-policy.ts).
  // What has actually been received, in USD, across every charge and any
  // payment staff recorded by hand (bank transfer, cash).
  amountPaid    Int       @default(0)
  // What secures the booking (50%, or the whole stay when booked within 14
  // days of arrival). Null on bookings from before the policy: those paid in full.
  depositAmount Int?
  // When the balance is due (14 days before arrival); null when nothing is left.
  balanceDueAt  DateTime?
  // The amount of the Paynow charge in flight; cleared once it is credited, so
  // a charge can never be counted twice.
  paynowChargeAmount Int?
  // Date changes made so far — only the first can be free (clause 4).
  dateChanges   Int       @default(0)
  // When the guest agreed to the policy (the checkbox, or confirming in WhatsApp).
  policyAcceptedAt DateTime?
  // What the policy says goes back on cancellation, after the 5% fee, in cents.
  refundAmountCents Int?
  refundStatus String?
  refundNote   String?
  refundedBy   String?
  refundedAt   DateTime?
  notifications Notification[]
  paymentEvents PaymentEvent[]
  receipts      Receipt[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([guestEmail])
  @@index([propertyId, checkIn])
  @@index([propertyId, bookingStatus])
  @@index([channel])
  @@index([bookingStatus, holdExpiresAt])
  @@index([refundStatus])
  @@map("booking")
}

model ChatMessage {
  id         String    @id @default(cuid())
  sessionId  String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  sender     String
  content    String
  // Staff mark a thread handled so the inbox can show what still needs a reply.
  handledAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([propertyId])
  @@map("chat_message")
}

// An email about a booking, written in the same step as the change it reports
// and delivered later by the API server (apps/server/src/notification-worker.ts).
// A mail outage therefore delays a message but never loses or blocks a booking,
// and every message has a visible outcome staff can check and retry.
model Notification {
  id            String    @id @default(cuid())
  // Exactly one of these: a stay, or a day visit.
  bookingId     String?
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  dayVisitBookingId String?
  dayVisitBooking   DayVisitBooking? @relation(fields: [dayVisitBookingId], references: [id], onDelete: Cascade)
  // created | confirmed | cancelled | expired | review — see notifications.ts
  event         String
  // guest | staff
  audience      String
  recipient     String
  subject       String
  body          String
  // pending | sent | failed | skipped
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // One message per event per recipient, so the poller, the Paynow callback
  // and a sweep reporting the same payment can all queue it and one is sent.
  @@unique([bookingId, event, recipient])
  @@unique([dayVisitBookingId, event, recipient])
  @@index([status, nextAttemptAt])
  @@map("notification")
}

// A day out with no night's stay — the garden, the grounds, lunch — that
// staff set up per property. Guests ask for a date; staff confirm it.
model DayVisit {
  id             String   @id @default(cuid())
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug           String
  name           String
  description    String
  // Per person, whole dollars. Null is "price to be announced": the lodge has
  // not set one yet, and guests can still ask to come.
  pricePerPerson Int?
  currency       String   @default("USD")
  // Optional: without photos the property's own cover stands in.
  image          String   @default("")
  images         String[] @default([])
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bookings       DayVisitBooking[]

  @@unique([propertyId, slug])
  @@index([propertyId])
  @@map("day_visit")
}

// A guest's request to come for a day visit. Nothing is paid online: staff
// confirm the date (quoting a price if none was published) or decline it.
model DayVisitBooking {
  id             String    @id @default(cuid())
  // FD-XXXXXX, apart from a stay's FC- references.
  reference      String    @unique
  dayVisitId     String
  dayVisit       DayVisit  @relation(fields: [dayVisitId], references: [id], onDelete: Restrict)
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Snapshot, so renaming the visit later never rewrites what a guest asked for.
  visitName      String
  // UTC midnight, like a stay's dates.
  visitDate      DateTime
  guests         Int
  guestName      String
  guestEmail     String
  guestPhone     String
  note           String?
  // The published price when the guest asked, or what staff quoted on
  // confirming. Null while still to be announced.
  pricePerPerson Int?
  // requested | confirmed | declined | cancelled
  status         String    @default("requested")
  staffNote      String?
  handledBy      String?
  handledAt      DateTime?
  channel        String    @default("web")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notifications  Notification[]

  @@index([propertyId, visitDate])
  @@index([status])
  @@map("day_visit_booking")
}

// Nights staff have taken off sale: maintenance, the owners' own use, a
// closed season. Read by every availability check alongside bookings (see
// packages/db/src/room-blocks.ts), so a blocked night is unbookable on the
// site, in WhatsApp and in the calendar at once.
model RoomBlock {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // UTC midnights, like Booking.checkIn/checkOut: startDate is the first
  // blocked night, endDate the morning it opens again (exclusive).
  startDate DateTime
  endDate   DateTime
  reason    String
  // Staff email, for the record of who took the room off sale.
  createdBy String
  createdAt DateTime @default(now())

  @@index([roomId, startDate])
  @@map("room_block")
}

// What Paynow told us, and what we did with it: every result callback
// (including forged or mismatched ones), plus polls that confirmed a payment
// or failed to reach Paynow. The audit trail for "the guest says they paid",
// and what the dashboard's attention panel counts to spot a Paynow outage.
model PaymentEvent {
  id              String   @id @default(cuid())
  // Null when the event could not be tied to a booking (e.g. a forged callback).
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // callback | poll
  source          String
  // The reference as CLAIMED by the event — unverified when outcome is rejected.
  reference       String?
  // Paynow's status string, e.g. "paid", "cancelled"
  status          String?
  // confirmed | already-paid | status-recorded | amount-mismatch |
  // poll-url-mismatch | unknown-booking | no-payment-started | rejected | error
  outcome         String
  detail          String?
  amount          String?
  paynowReference String?
  createdAt       DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([outcome, createdAt])
  @@map("payment_event")
}

// One receipt per payment received — a Paynow charge credited, or a bank
// transfer / cash payment staff recorded. Issued in the same step that
// credits the money, so a receipt always matches amountPaid. The id (a cuid)
// is the download key: unguessable, unlike the booking reference.
model Receipt {
  id              String   @id @default(cuid())
  // Sequential and never reused; shown as FCR-<year>-<6 digits>.
  number          Int      @unique @default(autoincrement())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Whole USD received by this payment.
  amount          Int
  // deposit | balance | full | part
  kind            String
  // ecocash | onemoney | innbucks | visa | bank_transfer | cash
  method          String
  // paynow | manual
  source          String
  paynowReference String?
  // Staff note for a manual payment (bank reference, receipt book no.).
  note            String?
  // The booking's totals right after this payment, frozen for the receipt.
  paidToDate      Int
  balanceAfter    Int
  issuedAt        DateTime @default(now())

  @@index([bookingId, issuedAt])
  @@map("receipt")
}
