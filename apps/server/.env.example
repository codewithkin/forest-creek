# Auth
BETTER_AUTH_SECRET=change-me-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
# Shared session-cookie domain between web and API (e.g. .christusveritastech.co.zw).
# Omit for localhost; packages/auth also derives it from BETTER_AUTH_URL.
COOKIE_DOMAIN=

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/forest-creek

# Admin user — created/kept-in-sync automatically on every server start (and by `pnpm db:seed`)
ADMIN_EMAIL=admin@forestcreeklodge.co.zw
ADMIN_PASSWORD=change-me

# AI concierge (Mastra + OpenRouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/deepseek/deepseek-v3.2

# Cloudflare R2 (property & room images)
# Create a bucket, then an R2 API token with Object Read & Write.
# R2_PUBLIC_URL is the bucket's public r2.dev address or your custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-c7dca0170fc54d3f90adb45158a92059.r2.dev

# Paynow (mobile money — Ecocash/OneMoney only)
# Get these from your Paynow merchant account: https://developers.paynow.co.zw
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# The API's public URL; Paynow POSTs payment results to $SERVER_URL/paynow/result.
# Defaults to BETTER_AUTH_URL. Set it on the WhatsApp agent too.
SERVER_URL=

# Booking emails (SMTP). Leave SMTP_HOST empty to run without email; queued
# messages are then marked skipped. Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Forest Creek <admin@forestcreek.co.zw>"

# WhatsApp agent (apps/agent)
AGENT_PORT=3002
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Set in Docker; locally puppeteer falls back to a system Chrome/Chromium
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Set to false to run the agent API without launching a browser
WHATSAPP_ENABLED=true
